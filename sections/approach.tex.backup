\chapter{Comparative Evaluation and Selection}\label{chap:comparison}

This chapter evaluates algorithms against six criteria, presenting multi-criteria scoring to select the optimal approach for LASSO integration. Analysis is grounded in 33 reference papers across all algorithm categories.

\section{Criterion-by-Criterion Evaluation}

\subsection{C1: SRM Compatibility}

SRM compatibility determines whether an algorithm can operate using only stimulus-response matrices without requiring control-flow graphs or language-specific analysis.

\begin{table}[H]
  \centering
  \footnotesize
  \caption{C1: SRM Compatibility.}
  \label{tab:c1-srm}
  \begin{tabular}{@{}p{4cm}p{1.5cm}p{6cm}@{}}
    \toprule
    \textbf{Algorithm} & \textbf{Pass} & \textbf{Justification} \\
    \midrule
    Greedy variants & \checkmark & Operate on coverage matrices~\cite{chvatal1979,harrold1993} \\
    ILP, NEMO, ITSM & \checkmark & Set-cover formulation~\cite{yoo2012,lin2018,nishino2020} \\
    GA, PSO/ABC, Many-Obj EA & \checkmark & Fitness on coverage data~\cite{yoo2012,ahuja2024,wei2017} \\
    Similarity/Overlap-Aware & \checkmark & Distance metrics~\cite{khan2020,bach2017} \\
    REDUNET & $\times$ & Requires CFG analysis~\cite{mongiovi2020} \\
    \bottomrule
  \end{tabular}
\end{table}

\noindent \textbf{Finding:} 12/13 algorithms pass; REDUNET excluded from further evaluation.

\subsection{C2: Coverage Preservation}

\begin{table}[H]
  \centering
  \footnotesize
  \caption{C2: Coverage Preservation (score $0$--$5$).}
  \label{tab:c2-coverage}
  \begin{tabular}{@{}l@{\hspace{1.5cm}}cc@{}}
    \toprule
    \textbf{Algorithm} & \textbf{Score} & \textbf{Guarantee} \\
    \midrule
    Greedy variants, ILP, NEMO, ITSM & $5/5$ & 100\% by design~\cite{chvatal1979,lin2018} \\
    Many-Objective EA & $4/5$ & High, configurable~\cite{wei2017} \\
    GA, PSO/ABC, Similarity & $1/5$ & Variable, parameter-dependent \\
    Overlap-Aware & $2/5$ & Time-budget constrained~\cite{bach2017} \\
    \bottomrule
  \end{tabular}
\end{table}

\noindent \textbf{Finding:} Greedy and exact methods guarantee 100\% coverage by algorithm design. Metaheuristics provide variable coverage.

\subsection{C3: Reduction Effectiveness}

\begin{table}[H]
  \centering
  \footnotesize
  \caption{C3: Reduction Effectiveness (score $0$--$5$).}
  \label{tab:c3-reduction}
  \begin{tabular}{@{}l@{\hspace{1.5cm}}cc@{}}
    \toprule
    \textbf{Algorithm} & \textbf{Score} & \textbf{Typical Reduction} \\
    \midrule
    ILP, NEMO & $5/5$ & Optimal solution~\cite{yoo2012,lin2018} \\
    Classical/Enhanced Greedy & $4/5$ & 70--74\%~\cite{chvatal1979,gladston2015} \\
    Many-Obj EA, ITSM & $4/5$ & 60--75\%~\cite{wei2017,nishino2020} \\
    GA, PSO/ABC, Delayed Greedy & $3/5$ & Variable, 65\%~\cite{yoo2012,jehan2023} \\
    Similarity-Based, Overlap-Aware & $2/5$ & Moderate, context-dependent \\
    \bottomrule
  \end{tabular}
\end{table}

\noindent \textbf{Finding:} Exact methods achieve optimality. Greedy heuristics achieve strong reduction (70\%). Metaheuristics show variable performance.

\subsection{C4: Mutation Score Preservation}

\begin{table}[H]
  \centering
  \footnotesize
  \caption{C4: Mutation Score Preservation (score $0$--$5$).}
  \label{tab:c4-mutation}
  \begin{tabular}{@{}l@{\hspace{1.5cm}}cc@{}}
    \toprule
    \textbf{Algorithm} & \textbf{Score} & \textbf{Retention} \\
    \midrule
    Many-Obj EA+Mutation, Delayed Greedy & $5/5$ & 0\% loss~\cite{wei2017,jehan2023} \\
    MA-EHGS & $5/5$ & Minimal loss via $\beta$-parameter \\
    Classical/HGS Greedy & $3/5$ & 0--5\% loss~\cite{jehan2023} \\
    Enhanced HGS, ILP, NEMO, others & $0/5$ & No evaluation \\
    \bottomrule
  \end{tabular}
\end{table}

\noindent \textbf{Finding:} Critical gap: most algorithms lack mutation evaluation. Mutation-aware approaches (Wei et al.~\cite{wei2017}) achieve 95--100\% retention.

\subsection{C5: Computational Scalability}

\begin{table}[H]
  \centering
  \footnotesize
  \caption{C5: Computational Scalability (score $0$--$5$).}
  \label{tab:c5-scalability}
  \begin{tabular}{@{}l@{\hspace{1.5cm}}cc@{}}
    \toprule
    \textbf{Algorithm} & \textbf{Score} & \textbf{Complexity} \\
    \midrule
    Classical/Enhanced Greedy, MA-EHGS & $5/5$ & $O(nm)$ polynomial \\
    HGS & $4/5$ & $O(|T| \cdot \max|T_i|)$~\cite{harrold1993} \\
    Overlap-Aware & $4/5$ & $O(n^2m)$, <10s practical~\cite{bach2017} \\
    Similarity-Based & $3/5$ & $O(n^2m)$ optimized~\cite{khan2020} \\
    GA, PSO/ABC, Many-Obj EA, ITSM & $2/5$ & $O(gnm)$ or solver-dependent \\
    ILP, NEMO, Delayed Greedy & $1$--$2/5$ & Exponential/quadratic \\
    \bottomrule
  \end{tabular}
\end{table}

\noindent \textbf{Finding:} Greedy methods scale linearly. Exact and metaheuristic methods face exponential or quadratic complexity, limiting large-scale application.

\subsection{C6: Implementation Feasibility}

\begin{table}[H]
  \centering
  \footnotesize
  \caption{C6: Implementation Feasibility (score $0$--$5$).}
  \label{tab:c6-feasibility}
  \begin{tabular}{@{}l@{\hspace{1.5cm}}cc@{}}
    \toprule
    \textbf{Algorithm} & \textbf{Score} & \textbf{Infrastructure} \\
    \midrule
    Classical Greedy & $5/5$ & Simple iteration, no tuning \\
    MA-EHGS, Enhanced HGS & $4/5$ & One parameter ($\beta$) \\
    HGS, Overlap-Aware & $4/5$ & Moderate infrastructure \\
    Similarity-Based & $3/5$ & Clustering library \\
    GA, PSO/ABC, Many-Obj EA & $2/5$ & Extensive parameter tuning \\
    Delayed Greedy, ITSM & $2/5$ & Complex data structures \\
    ILP, NEMO & $1/5$ & External solver integration \\
    \bottomrule
  \end{tabular}
\end{table}

\noindent \textbf{Finding:} Greedy approaches require minimal infrastructure. Solver-based methods and metaheuristics incur significant integration costs.

